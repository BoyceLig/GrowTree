{
  "name": "manalong",
  "version": "2026.11.16",
  "private": true,
  "description": "满伴成长树 - 家庭积分管理系统",
  "author": "BoyceLig (https://github.com/BoyceLig/ManAlong)",
  "license": "BUSL-1.1",
  "repository": {
    "type": "git",
    "url": "https://github.com/BoyceLig/ManAlong.git"
  },
  "workspaces": [
    "server",
    "web"
  ],
  "scripts": {
    "dev:server": "npm run dev --workspace server",
    "dev:web": "npm run dev --workspace web",
    "build": "npm run build --workspace web && npm run build --workspace server",
    "start": "node server/dist/index.js",
    "dev": "concurrently -k -n server,web \"npm:dev:server\" \"npm:dev:web\""
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  },
  "dependencies": {
    "@types/ws": "^8.18.1",
    "ws": "^8.21.3"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "esbuild@0.21.5": true,
    "better-sqlite3@12.11.1": true,
    "vue-demi@0.14.10": true
  }
}
